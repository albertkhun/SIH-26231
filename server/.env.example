PORT=5001
# MongoDB connection string. Local:
MONGO_URI=mongodb://127.0.0.1:27017/chromaproof
# MongoDB Atlas (replace user/password/cluster; URL-encode special characters in the password):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chromaproof?retryWrites=true&w=majority
# Origin(s) allowed by CORS, comma-separated. Dev: the Vite server (HTTPS, any LAN host).
CORS_ORIGIN=https://localhost:5173
# Supervisor code required to enrol devices and revoke keys. Leave empty to allow open enrolment (dev only).
ENROL_CODE=
# Set to "off" to disable the tamper demonstration endpoints.
TAMPER_DEMO=on
# DEMO_MODE=on uses server/config/demo.json (PLACEHOLDER values, flagged DEMO in every record). Never for real tests.
DEMO_MODE=off
